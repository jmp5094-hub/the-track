rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /global/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /bets/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /history/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /bank/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /chat/{raceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /userindex/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /friends/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /private/{doc} {
      allow read, write: if false;
    }
    match /raceRolls/{raceId} { allow read: if true; allow write: if false; 
    }

  }
}