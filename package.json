{
  "name": "the-track",
  "version": "1.0.0",
  "dependencies": {
    "firebase": "^10.7.0",
    "lottie-react": "^2.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.159.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "node --test src/broadcast/*.test.mjs tests/*.test.mjs",
    "test:finance": "node --test --test-concurrency=1 tests/finance.emulator.mjs tests/scheduler.emulator.mjs",
    "test:emulators": "firebase emulators:exec --only auth,firestore,functions --project demo-track --config firebase.test.json \"npm run test:finance\""
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0"
  }
}
